{
  "name": "dsh-speech-input",
  "version": "0.2.3",
  "description": "A microphone button for DeepSeek Harness that writes browser speech recognition into the composer draft.",
  "author": "liznee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liznee/dsh-speech-input.git"
  },
  "homepage": "https://github.com/liznee/dsh-speech-input#readme",
  "bugs": {
    "url": "https://github.com/liznee/dsh-speech-input/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.map",
    "src/**/*.js",
    "scripts/build.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "microphone",
    "speech-to-text",
    "voice-input",
    "web-speech-api"
  ],
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^19.2.8",
    "react-test-renderer": "^19.2.8"
  }
}
